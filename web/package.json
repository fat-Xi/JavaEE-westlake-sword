{
  "name": "westlake-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "format": "prettier --write src vite.config.js package.json tests",
    "format:check": "prettier --check src vite.config.js package.json tests",
    "format:java": "prettier --plugin=prettier-plugin-java --write ../src/**/*.java",
    "test:ui": "node tests/v5.mjs",
    "test:edges": "node tests/v4-edges.mjs",
    "test:files": "node tests/v5-files.mjs",
    "test:scan": "node tests/v6.mjs",
    "test:community": "node tests/community.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "vite": "^6.1.0"
  }
}
